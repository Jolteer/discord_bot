# Copy this file to .env and fill it in. Never commit or share .env.
# These are the ONLY global settings. Everything about a particular Discord
# server is stored per server in the database and edited on the dashboard.
#
# Required by process:
#   Bot:        DISCORD_TOKEN (+ DATABASE_URL if not using the default)
#   Dashboard:  DISCORD_TOKEN, DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET, SESSION_SECRET
# DOMAIN is read only by Docker Compose / Caddy, not by the Python app.

# Developer Portal → your app → Bot → Reset Token. Used by the bot AND by the
# dashboard (to list a server's channels and roles). Required.
DISCORD_TOKEN=paste-your-bot-token-here

# Developer Portal → your app → OAuth2. Used for "Login with Discord".
# Required by the dashboard (bot process does not use these).
DISCORD_CLIENT_ID=paste-your-application-id-here
DISCORD_CLIENT_SECRET=paste-your-client-secret-here

# A long random string. Required by the dashboard (session cookie HMAC).
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me

# Where the dashboard is reachable, without a trailing slash. Used for the
# OAuth redirect (PUBLIC_BASE_URL + /auth/callback) and links.
# Local development:  http://localhost:8000
# Production:         https://joltbot.example.com
PUBLIC_BASE_URL=http://localhost:8000

# SQLite file shared by the bot and the dashboard. To move to Postgres later:
#   DATABASE_URL=postgresql+asyncpg://user:password@localhost/joltbot
DATABASE_URL=sqlite+aiosqlite:///data/joltbot.db
# In Docker this is set for you (/app/data/joltbot.db, in the joltbot-data volume).

# ---------------------------------------------------------------- optional
# Defaults are shown. docker-compose.yml sets HOST, PORT and LOG_DIR itself.

# Where the dashboard listens. 127.0.0.1 = this machine only.
# HOST=127.0.0.1
# PORT=8000

# Reverse proxies whose X-Forwarded-* headers are trusted (comma-separated IPs, or *).
# FORWARDED_ALLOW_IPS=127.0.0.1

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
# LOG_LEVEL=INFO

# Folder for rotating log files. Leave empty to log to the console only.
# LOG_DIR=logs

# text = readable lines. json = one JSON object per line (ts, level, logger,
# message, plus fields like guild_id), for log tools that filter by field.
# LOG_FORMAT=text

# Get told when something breaks: ERROR-level log lines from the bot and the
# dashboard are posted to this Discord webhook. Create one in a private channel
# (Edit Channel → Integrations → Webhooks → New Webhook → Copy Webhook URL).
# Treat the URL like a password: anyone who has it can post to that channel.
# Test it with:  python -m joltbot.bot --test-alert
# ALERT_WEBHOOK_URL=

# Docker + Caddy only: the domain Caddy gets an HTTPS certificate for.
# Must match PUBLIC_BASE_URL (https://<DOMAIN>).
# DOMAIN=joltbot.example.com
#
# No domain yet? sslip.io gives every server a free name made from its IP address,
# with nothing to register: for the IP 203.0.113.7 that is
#   DOMAIN=203-0-113-7.sslip.io
#   PUBLIC_BASE_URL=https://203-0-113-7.sslip.io
# Moving to a real domain later means changing these two lines and adding the new
# https://<DOMAIN>/auth/callback redirect in the Discord Developer Portal.
