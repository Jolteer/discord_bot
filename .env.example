# Copy this file to .env and fill it in. Never commit or share .env.
# These are the ONLY global settings. Everything about a particular Discord
# server is stored per server in the database and edited on the dashboard.

# Developer Portal → your app → Bot → Reset Token. Used by the bot AND by the
# dashboard (to list a server's channels and roles).
DISCORD_TOKEN=paste-your-bot-token-here

# Developer Portal → your app → OAuth2. Used for "Login with Discord".
DISCORD_CLIENT_ID=paste-your-application-id-here
DISCORD_CLIENT_SECRET=paste-your-client-secret-here

# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me

# Where the dashboard is reachable, without a trailing slash. Used for the
# OAuth redirect (PUBLIC_BASE_URL + /auth/callback) and links.
# Local development:  http://localhost:8000
# Production:         https://joltbot.example.com
PUBLIC_BASE_URL=http://localhost:8000

# SQLite file shared by the bot and the dashboard. To move to Postgres later:
#   DATABASE_URL=postgresql+asyncpg://user:password@localhost/joltbot
DATABASE_URL=sqlite+aiosqlite:///data/joltbot.db
